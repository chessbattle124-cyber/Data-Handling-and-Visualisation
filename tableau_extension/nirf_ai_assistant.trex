<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.nirf.analytics.assistant" extension-version="1.0.1">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>NIRF 2017–2025 natural-language analytics assistant.</description>
    <author name="NIRF Analytics Project" email="nirf-ai-assistant@example.com" organization="NIRF Analytics Project" website="https://www.tableau.com"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>http://localhost:8000/index.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">NIRF AI Assistant</text>
    </resource>
  </resources>
</manifest>
